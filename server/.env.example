PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-different-32-character-secret

# Persistent storage: leave blank for local JSON storage, or set MongoDB Atlas URI.
MONGO_URI=

# Groq integration (OpenAI-compatible Responses API + Structured Outputs).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Keep false initially; private repository text is not sent to Groq.
GROQ_ALLOW_PRIVATE_REPO_CONTENT=false

# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth App credentials. Callback URL must match GitHub OAuth App settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback
